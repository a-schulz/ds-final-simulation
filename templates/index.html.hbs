<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SMD-Fertigungssimulation</title>
    <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
    <header>
        <h1>Simulation eines SMD-Fertigungsprozesses</h1>
    </header>

    <main>
        <section class="config-section">
            <h2>Simulationskonfiguration</h2>
            <form action="/config" method="post">
                <div class="config-group">
                    <h3>Stationszeiten</h3>
                    <div class="form-field">
                        <label for="smd_time_minutes">SMD-Zeit (min):</label>
                        <input type="number" id="smd_time_minutes" name="smd_time_minutes" step="0.1" value="{{config.smd_time_minutes}}">
                    </div>
                    <div class="form-field">
                        <label for="lotbad_batch_size">Lotbad Batchgröße:</label>
                        <input type="number" id="lotbad_batch_size" name="lotbad_batch_size" value="{{config.lotbad_batch_size}}">
                    </div>
                    <div class="form-field">
                        <label for="lotbad_batches_per_hour">Lotbad Durchläufe/h:</label>
                        <input type="number" id="lotbad_batches_per_hour" name="lotbad_batches_per_hour" value="{{config.lotbad_batches_per_hour}}">
                    </div>
                    <!-- Weitere Zeitkonfigurationen -->
                </div>

                <div class="config-group">
                    <h3>Kapazitäten</h3>
                    <div class="form-field">
                        <label for="buffer_capacity">Pufferkapazität:</label>
                        <input type="number" id="buffer_capacity" name="buffer_capacity" value="{{config.buffer_capacity}}">
                    </div>
                    <div class="form-field">
                        <label for="montage_stations">Montageplätze:</label>
                        <input type="number" id="montage_stations" name="montage_stations" value="{{config.montage_stations}}">
                    </div>
                    <div class="form-field">
                        <label for="test_stations">Testplätze:</label>
                        <input type="number" id="test_stations" name="test_stations" value="{{config.test_stations}}">
                    </div>
                </div>

                <div class="config-group">
                    <h3>Simulationsparameter</h3>
                    <div class="form-field">
                        <label for="simulation_duration_hours">Simulationsdauer (h):</label>
                        <input type="number" id="simulation_duration_hours" name="simulation_duration_hours" step="0.1" value="{{config.simulation_duration_hours}}">
                    </div>
                    <div class="form-field">
                        <label for="warm_up_period_hours">Anlaufphase (h):</label>
                        <input type="number" id="warm_up_period_hours" name="warm_up_period_hours" step="0.1" value="{{config.warm_up_period_hours}}">
                    </div>
                    <div class="form-field">
                        <label for="replications">Wiederholungen:</label>
                        <input type="number" id="replications" name="replications" value="{{config.replications}}">
                    </div>
                </div>

                <div class="buttons">
                    <button type="submit">Konfiguration speichern</button>
                </div>
            </form>
        </section>

        <section class="run-section">
            <h2>Simulation starten</h2>
            <form action="/run" method="post">
                <button type="submit">Simulation ausführen</button>
            </form>

            {{#if has_results}}
            <div class="results-link">
                <a href="/results">Ergebnisse anzeigen</a>
            </div>
            {{/if}}
        </section>
    </main>

    <footer>
        <p>&copy; 2023 SMD-Fertigungssimulation</p>
    </footer>
</body>
</html>